<title>Sushant Balunda | Personal Profile</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,800&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#0E1330; --cobalt:#2338F0; --cobalt-dark:#1A2AC4; --paper:#F2F4F9;
  --chalk:#FFFFFF; --muted:#4A5270; --line:#CBD1E2;
  --display:"Bricolage Grotesque","Helvetica Neue",Arial,sans-serif;
  --body:"Newsreader",Georgia,"Times New Roman",serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--paper);color:var(--ink);font-family:var(--body);font-size:1.2rem;line-height:1.65}
a{color:inherit}
a:focus-visible{outline:3px solid var(--ink);outline-offset:4px;border-radius:2px}
.on-dark a:focus-visible{outline-color:var(--chalk)}
section{scroll-margin-top:72px}
.wrap{width:min(1120px,90%);margin:0 auto}

/* Header */
.site-header{position:sticky;top:0;z-index:10;background:var(--cobalt);color:var(--chalk)}
.navbar{display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:68px}
.brand{font-family:var(--display);font-weight:800;font-size:1.15rem;text-decoration:none}
.nav-links{display:flex;gap:28px;list-style:none;font-family:var(--display);font-weight:500;font-size:1rem}
.nav-links a{text-decoration:none;padding:4px 0;border-bottom:2px solid transparent}
.nav-links a:hover{border-bottom-color:var(--chalk)}

/* Hero */
.hero{background:var(--cobalt);color:var(--chalk);padding:clamp(56px,10vw,120px) 0 clamp(64px,10vw,130px);overflow:hidden}
.hero h1{font-family:var(--display);font-weight:800;font-size:clamp(3.4rem,13.5vw,11.5rem);line-height:.9;letter-spacing:-.045em;margin-bottom:clamp(32px,5vw,64px)}
.hero h1 span{display:block;overflow:hidden;padding-bottom:.06em}
.hero h1 span b{display:block;font-weight:inherit;transform:translateY(105%);animation:rise 900ms cubic-bezier(.2,.8,.2,1) forwards}
.hero h1 span:nth-child(2) b{animation-delay:140ms}
@keyframes rise{to{transform:none}}
.hero-foot{display:grid;grid-template-columns:1fr auto;gap:32px;align-items:end;border-top:1px solid rgba(255,255,255,.4);padding-top:28px}
.hero-text{max-width:34ch;font-size:clamp(1.3rem,2.4vw,1.75rem);line-height:1.4}
.button{display:inline-block;background:var(--chalk);color:var(--cobalt);font-family:var(--display);font-weight:800;font-size:1.05rem;text-decoration:none;padding:16px 30px;border-radius:999px;transition:background-color .2s,color .2s}
.button:hover{background:var(--ink);color:var(--chalk)}

/* Sections */
.section{padding:clamp(72px,10vw,128px) 0;border-bottom:1px solid var(--line)}
.split{display:grid;grid-template-columns:minmax(0,4fr) minmax(0,8fr);gap:clamp(24px,5vw,72px)}
h2{font-family:var(--display);font-weight:800;font-size:clamp(2rem,4.5vw,3.2rem);line-height:1.05;letter-spacing:-.03em}
.about-text{max-width:58ch;color:var(--muted);font-size:1.3rem;line-height:1.7}
.about-text + .about-text{margin-top:1.1em}
.about-text strong{color:var(--ink);font-weight:500}

/* Skills */
.skills-list{list-style:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:clamp(24px,4vw,56px)}
.skills-list li{font-family:var(--display);font-weight:500;font-size:clamp(1.25rem,2.4vw,1.7rem);letter-spacing:-.01em;padding:18px 0;border-top:1px solid var(--line)}
.skills-list li:nth-last-child(-n+2){border-bottom:1px solid var(--line)}

/* Projects */
.project-list{list-style:none;border-top:2px solid var(--ink)}
.project{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,5fr) auto;gap:clamp(16px,3vw,40px);align-items:baseline;padding:34px 20px;margin:0 -20px;border-bottom:1px solid var(--line);transition:background-color .2s,color .2s}
.project h3{font-family:var(--display);font-weight:800;font-size:clamp(1.5rem,3vw,2.2rem);line-height:1.1;letter-spacing:-.025em}
.project p{color:var(--muted);font-size:1.15rem;line-height:1.5;transition:color .2s}
.project a{font-family:var(--display);font-weight:800;font-size:1rem;white-space:nowrap;text-underline-offset:5px;text-decoration-thickness:2px}
.project:hover,.project:focus-within{background:var(--cobalt);color:var(--chalk)}
.project:hover p,.project:focus-within p{color:#DCE1FF}
.project:hover a:focus-visible,.project:focus-within a:focus-visible{outline-color:var(--chalk)}

/* Footer */
.site-footer{background:var(--ink);color:var(--chalk);padding:clamp(64px,9vw,112px) 0 32px}
.site-footer h2{font-size:clamp(2.4rem,7vw,5.5rem);letter-spacing:-.04em;margin-bottom:24px}
.contact{font-family:var(--display);font-weight:500;font-size:clamp(1.2rem,3vw,2rem);word-break:break-word}
.contact a{text-underline-offset:6px;text-decoration-thickness:2px}
.contact a:hover{color:#AEB8FF}
.legal{margin-top:clamp(56px,8vw,96px);padding-top:24px;border-top:1px solid rgba(255,255,255,.2);color:#B8BFDA;font-size:1rem}

/* Responsive */
@media (max-width:820px){
  .split{grid-template-columns:1fr}
  .hero-foot{grid-template-columns:1fr}
  .hero-foot .button{justify-self:start}
  .project{grid-template-columns:1fr;gap:10px;padding:28px 16px;margin:0 -16px}
}
@media (max-width:560px){
  .navbar{flex-direction:column;justify-content:center;gap:6px;padding:12px 0}
  .nav-links{gap:20px}
  .skills-list{grid-template-columns:1fr}
  .skills-list li:nth-last-child(2){border-bottom:0}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .hero h1 span b{animation:none;transform:none}
  *{transition:none!important}
}
</style>
</head>
